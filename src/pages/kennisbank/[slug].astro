---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { organizationSchema, websiteSchema, websiteId, organizationId } from '../../data/schema';
import { getArticles, articlePath, kennisbankPath, formatDate, isoDate, type Article } from '../../data/kennisbank';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, related: articles.filter((a) => a.id !== entry.id).slice(0, 2) } }));
}

interface Props {
  entry: Article;
  related: Article[];
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { title, heading, description, summary, category, publishedAt, updatedAt, sources, faq } = entry.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
const modified = updatedAt ?? publishedAt;
const authorId = `${site.url}/#ward-kennes`;

const schema = [
  organizationSchema(),
  websiteSchema(),
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    inLanguage: 'nl-BE',
  },
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: heading,
    description,
    abstract: summary.join(' '),
    articleSection: category,
    datePublished: isoDate(publishedAt),
    dateModified: isoDate(modified),
    inLanguage: 'nl-BE',
    mainEntityOfPage: { '@id': `${url}#webpage` },
    image: site.logo,
    author: {
      '@type': 'Person',
      '@id': authorId,
      name: site.founder,
      jobTitle: 'Webdeveloper',
      url: `${site.url}/`,
      sameAs: [site.linkedin],
      worksFor: { '@id': organizationId },
    },
    publisher: { '@id': organizationId },
    ...(sources.length > 0 && {
      citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
    }),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Kennisbank', item: new URL(kennisbankPath, site.url).href },
      { '@type': 'ListItem', position: 3, name: heading, item: url },
    ],
  },
  ...(faq.length > 0
    ? [{
        '@type': 'FAQPage',
        '@id': `${url}#faq`,
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }]
    : []),
];
---
<Base title={title} description={description} schema={schema}>

  <article>
    <header id="home" class="scroll-mt-32 px-4 pb-10 pt-32 sm:px-6 sm:pt-44">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Kruimelpad" class="mb-6 text-sm text-navy/60">
          <a href="/" class="transition hover:text-leaf">Home</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <a href={kennisbankPath} class="transition hover:text-leaf">Kennisbank</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <span aria-current="page">{category}</span>
        </nav>

        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">{category}</p>
        <h1 class="mt-3 text-3xl font-bold leading-[1.2] tracking-tight sm:text-4xl">{heading}</h1>

        <p class="mt-5 text-sm text-navy/60">
          Door <a href={site.linkedin} target="_blank" rel="noopener author" class="font-medium text-navy hover:text-leaf">{site.founder}</a>
          <span class="mx-1.5" aria-hidden="true">&middot;</span>
          <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
          {updatedAt && (
            <>
              <span class="mx-1.5" aria-hidden="true">&middot;</span>
              bijgewerkt op <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt)}</time>
            </>
          )}
        </p>

        <aside class="mt-8 rounded-3xl bg-white p-7 ring-1 ring-leaf/30" aria-labelledby="samenvatting-titel">
          <h2 id="samenvatting-titel" class="text-sm font-semibold uppercase tracking-wider text-leaf">In het kort</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-navy/80">
            {summary.map((line) => <li>{line}</li>)}
          </ul>
        </aside>
      </div>
    </header>

    <div class="px-4 pb-12 sm:px-6">
      <div class="prose-cc mx-auto max-w-3xl rounded-[2rem] bg-white p-8 ring-1 ring-navy/5 sm:p-12">
        <Content />
      </div>
    </div>

    {faq.length > 0 && (
      <section class="px-4 pb-12 sm:px-6" aria-labelledby="faq-titel">
        <div class="mx-auto max-w-3xl">
          <h2 id="faq-titel" class="text-2xl font-bold tracking-tight">Veelgestelde vragen</h2>
          <div class="mt-6 space-y-3">
            {faq.map((item) => (
              <div class="rounded-3xl bg-white p-7 ring-1 ring-navy/5">
                <h3 class="text-lg font-semibold">{item.q}</h3>
                <p class="mt-2 leading-relaxed text-navy/70">{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {sources.length > 0 && (
      <footer class="px-4 pb-12 sm:px-6">
        <div class="mx-auto max-w-3xl text-sm text-navy/60">
          <h2 class="font-semibold uppercase tracking-wider text-navy/70">Bronnen</h2>
          <ul class="mt-3 space-y-1.5">
            {sources.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener" class="underline decoration-leaf underline-offset-4 hover:text-leaf">{s.title}</a></li>
            ))}
          </ul>
        </div>
      </footer>
    )}
  </article>

  {related.length > 0 && (
    <section class="px-4 pb-20 sm:px-6" aria-labelledby="meer-titel">
      <div class="mx-auto max-w-3xl">
        <h2 id="meer-titel" class="text-2xl font-bold tracking-tight">Meer uit de kennisbank</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {related.map((a) => (
            <a href={articlePath(a)} class="rounded-3xl bg-white p-7 ring-1 ring-navy/5 transition hover:ring-leaf/40">
              <p class="text-xs font-semibold uppercase tracking-wider text-leaf">{a.data.category}</p>
              <p class="mt-2 font-semibold leading-snug">{a.data.heading}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Base>
