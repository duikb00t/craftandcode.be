---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { organizationSchema, websiteSchema, websiteId, organizationId } from '../data/schema';

export async function getStaticPaths() {
  const regions = await getCollection('regions', ({ data }) => !data.draft);
  return regions.map((entry) => ({ params: { region: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { city, title, description, intro } = entry.data;
const url = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  organizationSchema(),
  websiteSchema(),
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    inLanguage: 'nl-BE',
    spatialCoverage: { '@type': 'City', name: city },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: `Webdeveloper in ${city}`, item: url },
    ],
  },
];
---
<Base title={title} description={description} geoPlacename={city} schema={schema}>

  <section id="home" class="scroll-mt-32 px-4 pb-12 pt-32 sm:px-6 sm:pt-44">
    <div class="mx-auto max-w-3xl">
      <nav aria-label="Kruimelpad" class="mb-6 text-sm text-navy/60">
        <a href="/" class="transition hover:text-leaf">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span aria-current="page">{city}</span>
      </nav>

      <h1 class="text-4xl font-bold leading-[1.15] tracking-tight sm:text-5xl">
        Webdeveloper in {city}
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-navy/70">{intro}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="#contact"
           class="inline-flex items-center justify-center rounded-full bg-navy px-7 py-4 text-sm font-semibold text-white transition hover:bg-navy-soft">
          Vraag een inschatting
        </a>
        <a href="/#diensten"
           class="inline-flex items-center justify-center rounded-full bg-white px-7 py-4 text-sm font-semibold text-navy ring-1 ring-navy/10 transition hover:bg-white/70">
          Bekijk de diensten
        </a>
      </div>
    </div>
  </section>

  <section class="px-4 pb-20 sm:px-6">
    <div class="mx-auto max-w-3xl rounded-[2rem] bg-white p-8 ring-1 ring-navy/5 sm:p-12
                leading-relaxed text-navy/80
                [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-navy [&_h2:first-child]:mt-0
                [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-navy
                [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5
                [&_a]:font-medium [&_a]:text-navy [&_a]:underline [&_a]:decoration-leaf [&_a]:underline-offset-4 [&_a:hover]:text-leaf">
      <Content />
    </div>
  </section>

</Base>
