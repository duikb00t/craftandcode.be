---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GoogleRating from '../components/GoogleRating.astro';
import { site, services, websiteServices, workArea, faq, clients } from '../data/site';
import { getArticles, articlePath, kennisbankPath } from '../data/kennisbank';
import { organizationSchema, websiteSchema, websiteId, organizationId } from '../data/schema';

const title = 'Webdesign en websites op maat in Duffel | Craft and Code';

// Published region pages, keyed by city, so work-area chips can link to them.
const regions = await getCollection('regions', ({ data }) => !data.draft);
const regionByCity = new Map(regions.map((r) => [r.data.city, `/webdeveloper-${r.id}/`]));

const latestArticles = (await getArticles()).slice(0, 3);

const schema = [
  organizationSchema(),
  websiteSchema(),
  {
    '@type': 'WebPage',
    '@id': `${site.url}/#webpage`,
    url: `${site.url}/`,
    name: title,
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    inLanguage: 'nl-BE',
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---
<Base
  title={title}
  description="Webdesign en websites op maat in Duffel. Craft and Code bouwt sites met Craft CMS, web applicaties en koppelingen voor regio Antwerpen en Mechelen."
  ogDescription="Websites op maat, Craft CMS en API-koppelingen voor bedrijven in regio Duffel, Antwerpen en Mechelen."
  schema={schema}
>

  <!-- HERO / H1 -->
  <section id="home" class="scroll-mt-32 px-4 pb-20 pt-32 sm:px-6 sm:pt-44">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">
        Webdeveloper in Duffel
      </p>

      <h1 class="mt-5 text-4xl font-bold leading-[1.15] tracking-tight sm:text-5xl">
        Websites op maat en maatwerk software in Duffel en regio Antwerpen
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-navy/70">
        Craft and Code is het bureau van <strong class="font-semibold text-navy">Ward Kennes</strong>.
        We bouwen websites met <strong class="font-semibold text-navy">Craft CMS</strong>,
        web applicaties en <strong class="font-semibold text-navy">API-koppelingen</strong>
        voor bedrijven in Duffel, Antwerpen, Mechelen, Lier en Rumst
      </p>

      <p class="mt-4 leading-relaxed text-navy/70">
        Geen thema dat je later tegenwerkt, maar een site die je zelf beheert en die meegroeit met je bedrijf.
      </p>

      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact/"
           class="inline-flex items-center justify-center rounded-full bg-navy px-7 py-4 text-sm font-semibold text-white transition hover:bg-navy-soft">
          Vraag een inschatting
        </a>
        <a href="#diensten"
           class="inline-flex items-center justify-center rounded-full bg-white px-7 py-4 text-sm font-semibold text-navy ring-1 ring-navy/10 transition hover:bg-white/70">
          Bekijk de diensten
        </a>
      </div>

      <GoogleRating class="mt-8" />
    </div>
  </section>

  <!-- DIENSTEN / H2 -->
  <section id="diensten" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="diensten-titel">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Diensten</p>
        <h2 id="diensten-titel" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Webdevelopment, Craft CMS en API-koppelingen
        </h2>
        <p class="mt-4 leading-relaxed text-navy/70">
          Vier diensten, allemaal vanuit dezelfde vraag: wat moet dit systeem over drie jaar nog kunnen?
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {services.map((service) => (
          <article class="rounded-3xl bg-white p-8 ring-1 ring-navy/5">
            <svg class="mb-4 h-7 w-7 text-leaf" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={service.icon}/>
            </svg>
            <h3 class="text-lg font-semibold">{service.name}</h3>
            <p class="mt-2 leading-relaxed text-navy/70">{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WEBSITE DIENSTEN / H2 -->
  <section id="website-diensten" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="website-diensten-titel">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-[2rem] bg-navy p-8 text-white sm:p-12">
        <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Website diensten</p>
            <h2 id="website-diensten-titel" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
              Alles rond je website, onder één dak
            </h2>
            <p class="mt-4 leading-relaxed text-white/70">
              Een website bouwen is één ding. Ze vindbaar, toegankelijk en up-to-date houden is minstens even belangrijk.
              Daarom neem je ook het ontwerp, de teksten en het onderhoud bij Craft and Code af.
            </p>
            <a href="/contact/"
               class="mt-8 inline-flex items-center rounded-full bg-leaf px-6 py-3 text-sm font-semibold text-navy-deep transition hover:bg-leaf-dark">
              Vraag een inschatting
            </a>
          </div>

          <ul class="grid gap-3 sm:grid-cols-2">
            {websiteServices.map((service) => (
              <li class="rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
                <h3 class="flex items-center gap-3 font-semibold">
                  <svg class="h-5 w-5 shrink-0 text-leaf" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={service.icon}/>
                  </svg>
                  {service.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-white/70">{service.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- KLANTEN / H2 -->
  <section id="klanten" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="klanten-titel">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Klanten</p>
        <h2 id="klanten-titel" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Een greep uit onze klanten
        </h2>
        <p class="mt-4 leading-relaxed text-navy/70">
          Van architectenbureau en drukkerij tot vastgoed: een selectie van de bedrijven uit regio Antwerpen en Mechelen waarvoor Craft and Code werkt.
        </p>
      </div>

      <!-- Lines are the 1px gaps showing the grid background, so they never double up or shift. -->
      <div class="overflow-hidden rounded-3xl ring-1 ring-navy/5">
        <ul class="grid grid-cols-2 gap-px bg-navy/5 md:grid-cols-4">
          {clients.map((client) => (
            <li class="group flex aspect-[3/2] items-center justify-center bg-white p-6 sm:p-10">
              {'mono' in client ? (
                // Hand-made mono version by default, colour version fades in on hover.
                <span class="relative inline-flex">
                  <img
                    src={client.mono}
                    alt={`Logo ${client.name}`}
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                    class:list={['h-auto w-auto max-w-full object-contain opacity-90 transition duration-300 group-hover:opacity-0', client.fit]}
                  />
                  <img
                    src={client.logo}
                    alt=""
                    aria-hidden="true"
                    width={client.width}
                    height={client.height}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-contain opacity-0 transition duration-300 group-hover:opacity-100"
                  />
                </span>
              ) : (
                <img
                  src={client.logo}
                  alt={`Logo ${client.name}`}
                  width={client.width}
                  height={client.height}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'h-auto w-auto max-w-full object-contain mix-blend-multiply grayscale opacity-90 transition duration-300 group-hover:opacity-100 group-hover:grayscale-0',
                    client.fit,
                  ]}
                />
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="mx-auto mt-12 max-w-2xl text-center">
        <p class="text-lg font-semibold">Benieuwd wat we voor jouw bedrijf kunnen bouwen?</p>
        <p class="mt-2 leading-relaxed text-navy/70">
          Laten we samenzitten en je project bespreken, bij jou ter plaatse of online.
        </p>
        <a href="/contact/"
           class="mt-6 inline-flex items-center justify-center rounded-full bg-navy px-7 py-4 text-sm font-semibold text-white transition hover:bg-navy-soft">
          Vraag een inschatting
        </a>
      </div>
    </div>
  </section>

  <!-- WERKGEBIED / H2 -->
  <section id="werkgebied" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="werkgebied-titel">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-[2rem] bg-white p-8 ring-1 ring-navy/5 sm:p-12">
        <div class="grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Werkgebied</p>
            <h2 id="werkgebied-titel" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
              Webdeveloper in Duffel, Antwerpen, Mechelen, Lier en Rumst
            </h2>
          </div>
          <div>
            <p class="leading-relaxed text-navy/70">
              Craft and Code werkt vanuit Duffel, op de as tussen Antwerpen en Mechelen. Overleg ter plaatse blijft
              daardoor realistisch: even samenzitten bij de start van een project, en daarna kort schakelen wanneer het
              nodig is. Werk je verder weg, dan verloopt de samenwerking digitaal en verandert er inhoudelijk niets aan de aanpak.
            </p>
            <ul class="mt-6 flex flex-wrap gap-2 text-sm font-medium">
              {workArea.map((city) => {
                const href = regionByCity.get(city);
                return href ? (
                  <li>
                    <a href={href} class="block rounded-full bg-sand px-4 py-2 ring-1 ring-navy/5 transition hover:text-leaf hover:ring-leaf/40">
                      {city}
                    </a>
                  </li>
                ) : (
                  <li class="rounded-full bg-sand px-4 py-2 ring-1 ring-navy/5">{city}</li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KENNISBANK / H2 -->
  {latestArticles.length > 0 && (
    <section id="kennisbank" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="kennisbank-titel">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Kennisbank</p>
            <h2 id="kennisbank-titel" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
              Helder uitgelegd
            </h2>
          </div>
          <a href={kennisbankPath} class="text-sm font-semibold underline decoration-leaf underline-offset-4 hover:text-leaf">
            Alle artikels
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {latestArticles.map((article) => (
            <a href={articlePath(article)} class="rounded-3xl bg-white p-7 ring-1 ring-navy/5 transition hover:ring-leaf/40">
              <p class="text-xs font-semibold uppercase tracking-wider text-leaf">{article.data.category}</p>
              <h3 class="mt-2 font-semibold leading-snug">{article.data.heading}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy/70">{article.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ / H2 -->
  <section id="faq" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="faq-titel">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Veelgestelde vragen</p>
        <h2 id="faq-titel" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Vragen over een website op maat
        </h2>
      </div>

      <div class="space-y-3">
        {faq.map((item) => (
          <article class="rounded-3xl bg-white p-7 ring-1 ring-navy/5">
            <h3 class="text-lg font-semibold">{item.q}</h3>
            <p class="mt-2 leading-relaxed text-navy/70">{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>
