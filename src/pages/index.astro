---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, services, workArea, faq } from '../data/site';
import { organizationSchema, websiteSchema, websiteId, organizationId } from '../data/schema';

const title = 'Webdevelopment & Craft CMS in Duffel | Craft and Code';

// Published region pages, keyed by city, so work-area chips can link to them.
const regions = await getCollection('regions', ({ data }) => !data.draft);
const regionByCity = new Map(regions.map((r) => [r.data.city, `/webdeveloper-${r.id}/`]));

const schema = [
  organizationSchema(),
  websiteSchema(),
  {
    '@type': 'WebPage',
    '@id': `${site.url}/#webpage`,
    url: `${site.url}/`,
    name: title,
    isPartOf: { '@id': websiteId },
    about: { '@id': organizationId },
    inLanguage: 'nl-BE',
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---
<Base
  title={title}
  description="Websites op maat, Craft CMS en API-koppelingen door Craft and Code uit Duffel Webdeveloper voor bedrijven in regio Antwerpen, Mechelen en Lier."
  ogDescription="Websites op maat, Craft CMS en API-koppelingen voor bedrijven in regio Duffel, Antwerpen en Mechelen."
  schema={schema}
>

  <!-- HERO / H1 -->
  <section id="home" class="scroll-mt-32 px-4 pb-20 pt-32 sm:px-6 sm:pt-44">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">
        Webdeveloper in Duffel
      </p>

      <h1 class="mt-5 text-4xl font-bold leading-[1.15] tracking-tight sm:text-5xl">
        Websites op maat en maatwerk software in Duffel en regio Antwerpen
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-navy/70">
        Craft and Code is het bureau van <strong class="font-semibold text-navy">Ward Kennes</strong>.
        We bouwen websites met <strong class="font-semibold text-navy">Craft CMS</strong>,
        web applicaties en <strong class="font-semibold text-navy">API-koppelingen</strong>
        voor bedrijven in Duffel, Antwerpen, Mechelen, Lier en Rumst
      </p>

      <p class="mt-4 leading-relaxed text-navy/70">
        Geen thema dat je later tegenwerkt, maar een site die je zelf beheert en die meegroeit met je bedrijf.
      </p>

      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="#contact"
           class="inline-flex items-center justify-center rounded-full bg-navy px-7 py-4 text-sm font-semibold text-white transition hover:bg-navy-soft">
          Vraag een inschatting
        </a>
        <a href="#diensten"
           class="inline-flex items-center justify-center rounded-full bg-white px-7 py-4 text-sm font-semibold text-navy ring-1 ring-navy/10 transition hover:bg-white/70">
          Bekijk de diensten
        </a>
      </div>
    </div>
  </section>

  <!-- DIENSTEN / H2 -->
  <section id="diensten" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="diensten-titel">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Diensten</p>
        <h2 id="diensten-titel" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Webdevelopment, Craft CMS en API-koppelingen
        </h2>
        <p class="mt-4 leading-relaxed text-navy/70">
          Vier diensten, allemaal vanuit dezelfde vraag: wat moet dit systeem over drie jaar nog kunnen?
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {services.map((service) => (
          <article class="rounded-3xl bg-white p-8 ring-1 ring-navy/5">
            <svg class="mb-4 h-7 w-7 text-leaf" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={service.icon}/>
            </svg>
            <h3 class="text-lg font-semibold">{service.name}</h3>
            <p class="mt-2 leading-relaxed text-navy/70">{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WERKGEBIED / H2 -->
  <section id="werkgebied" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="werkgebied-titel">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-[2rem] bg-white p-8 ring-1 ring-navy/5 sm:p-12">
        <div class="grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Werkgebied</p>
            <h2 id="werkgebied-titel" class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
              Webdeveloper in Duffel, Antwerpen, Mechelen, Lier en Rumst
            </h2>
          </div>
          <div>
            <p class="leading-relaxed text-navy/70">
              Craft and Code werkt vanuit Duffel, op de as tussen Antwerpen en Mechelen. Overleg ter plaatse blijft
              daardoor realistisch: even samenzitten bij de start van een project, en daarna kort schakelen wanneer het
              nodig is. Werk je verder weg, dan verloopt de samenwerking digitaal en verandert er inhoudelijk niets aan de aanpak.
            </p>
            <ul class="mt-6 flex flex-wrap gap-2 text-sm font-medium">
              {workArea.map((city) => {
                const href = regionByCity.get(city);
                return href ? (
                  <li>
                    <a href={href} class="block rounded-full bg-sand px-4 py-2 ring-1 ring-navy/5 transition hover:text-leaf hover:ring-leaf/40">
                      {city}
                    </a>
                  </li>
                ) : (
                  <li class="rounded-full bg-sand px-4 py-2 ring-1 ring-navy/5">{city}</li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ / H2 -->
  <section id="faq" class="scroll-mt-32 px-4 py-16 sm:px-6" aria-labelledby="faq-titel">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-leaf">Veelgestelde vragen</p>
        <h2 id="faq-titel" class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Vragen over een website op maat
        </h2>
      </div>

      <div class="space-y-3">
        {faq.map((item) => (
          <article class="rounded-3xl bg-white p-7 ring-1 ring-navy/5">
            <h3 class="text-lg font-semibold">{item.q}</h3>
            <p class="mt-2 leading-relaxed text-navy/70">{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

</Base>
