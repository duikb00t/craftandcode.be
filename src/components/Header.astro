---
// Links point to "/#section" so they also work from region pages.
const nav = [
  { href: '/#home', label: 'Home' },
  { href: '/#diensten', label: 'Diensten' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6 sm:pt-6">
  <div class="mx-auto max-w-6xl">
    <nav aria-label="Hoofdnavigatie" class="flex items-center justify-between gap-4 rounded-full bg-white/95 px-5 py-3 shadow-lg shadow-navy/5 ring-1 ring-navy/5 backdrop-blur-sm sm:px-6">

      <a href="/#home" class="flex items-baseline gap-1.5 text-lg font-semibold tracking-tight sm:text-xl" aria-label="Craft and Code, naar boven">
        <span>craft</span><span class="text-leaf">&amp;</span><span>code</span>
      </a>

      <ul class="hidden items-center gap-8 text-sm font-medium md:flex">
        {nav.map((item) => (
          <li><a href={item.href} class="nav-link transition hover:text-leaf">{item.label}</a></li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a href="/#contact" class="hidden rounded-full bg-navy px-5 py-2.5 text-sm font-medium text-white transition hover:bg-navy-soft sm:inline-flex">
          Contacteer ons
        </a>

        <button id="menu-toggle" type="button" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-menu"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full text-navy ring-1 ring-navy/10 transition hover:bg-sand md:hidden">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="mt-2 hidden rounded-3xl bg-white p-4 shadow-lg shadow-navy/5 ring-1 ring-navy/5 md:hidden">
      <ul class="flex flex-col text-sm font-medium">
        {nav.map((item) => (
          <li><a href={item.href} class="nav-link block rounded-2xl px-4 py-3 transition hover:bg-sand">{item.label}</a></li>
        ))}
      </ul>
      <a href="/#contact" class="mt-2 block rounded-full bg-navy px-5 py-3 text-center text-sm font-medium text-white transition hover:bg-navy-soft">
        Contacteer ons
      </a>
    </div>
  </div>
</header>
